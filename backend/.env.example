# ==========================================================================
# EcoRutas Wanchaq — Backend (Fase 3)
# Copia este archivo como ".env" y completa los valores reales.
# ==========================================================================

PORT=4000
NODE_ENV=development

# Secreto para firmar los JWT. Usa una cadena larga y aleatoria en producción
# (por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=coloca_un_secreto_largo_y_aleatorio_aqui
JWT_EXPIRES_IN=2h

# URL del frontend para configurar CORS en producción.
FRONTEND_URL=http://localhost:5500

# --------------------------------------------------------------------------
# PostgreSQL (Fase 3) — ver ../baseDatos_eccoCusco.sql para crear la base
# --------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eccoCusco
DB_USER=postgres
DB_PASSWORD=tu_password_local

# --------------------------------------------------------------------------
# Correo electrónico — elige UN proveedor gratuito con MAIL_PROVIDER
# --------------------------------------------------------------------------

# Opción 1 (por defecto): Gmail SMTP con "contraseña de aplicación"
# 1. Activa la verificación en 2 pasos en la cuenta de Gmail que usará la
#    municipalidad para notificaciones.
# 2. Genera una contraseña de aplicación en:
#    https://myaccount.google.com/apppasswords
# 3. Pega esa contraseña (16 caracteres, sin espacios) en GMAIL_APP_PASSWORD.
MAIL_PROVIDER=gmail
GMAIL_USER=tu_correo_municipalidad@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Opción 2: Resend (100 correos/día gratis) — https://resend.com
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=EcoRutas Wanchaq <onboarding@resend.dev>

# Opción 3: Brevo (300 correos/día gratis) — https://brevo.com
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=xxxxxxxxxxxxxxxx
# BREVO_SENDER_EMAIL=tu_correo_verificado@dominio.com
# BREVO_SENDER_NAME=EcoRutas Wanchaq

# Si MAIL_PROVIDER no es válido o falla el envío, el sistema cae en modo
# "consola" automáticamente: el correo se imprime en los logs del servidor
# para no bloquear el flujo de desarrollo/demostración.

# --------------------------------------------------------------------------
# Autocompletar nombres/apellidos a partir del DNI (opcional)
# --------------------------------------------------------------------------
# La consulta pública gratuita de RENIEC (apis.net.pe / decolecta.com) fue
# restringida por la normativa peruana de protección de datos personales y
# hoy solo se ofrece bajo acuerdo privado (dev@decolecta.com). Si consigues
# un token de un proveedor, pégalo aquí (nunca lo expongas en el frontend: el
# backend es el único que lo usa, en GET /api/dni/:numero).
# Si se deja vacío, el botón "Buscar DNI" del frontend simplemente avisa que
# no está disponible y el formulario se sigue llenando manualmente.
DNI_API_TOKEN=
